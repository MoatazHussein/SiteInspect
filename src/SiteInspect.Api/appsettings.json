{
  "AllowedHosts": "",
  "ConnectionStrings": {
    "Database": ""
  },
  "Jwt": {
    "Issuer": "SiteInspect",
    "Audience": "SiteInspect.Web",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "DemoData": {
    "Users": {
      "Manager": {
        "Password": ""
      },
      "Inspector": {
        "Password": ""
      },
      "Contractor": {
        "Password": ""
      }
    }
  },
  "Messaging": {
    "Enabled": false,
    "RabbitMq": {
      "Host": "rabbitmq://localhost",
      "Username": "guest",
      "Password": ""
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss zzz} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  }
}
