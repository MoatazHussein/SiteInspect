<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.3653345">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <BuildCommand>npm run build</BuildCommand>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist\site-inspect-web\browser\</BuildOutputFolder>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
  </PropertyGroup>

  <Target
    Name="RestoreAngularDependenciesForPublish"
    BeforeTargets="_RunNpmCommandForPublishAssets"
    Condition="'$(SiteInspectSkipNpmCi)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
