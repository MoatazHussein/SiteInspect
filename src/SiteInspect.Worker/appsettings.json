{
  "ConnectionStrings": {
    "Database": "Server=.\\SQLEXPRESS;Database=SiteInspect;Trusted_Connection=True;Encrypt=False;MultipleActiveResultSets=true"
  },
  "Messaging": {
    "Enabled": false,
    "RabbitMq": {
      "Host": "rabbitmq://localhost",
      "Username": "guest",
      "Password": ""
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "MassTransit": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  }
}
